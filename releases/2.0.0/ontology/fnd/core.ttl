@prefix core: <https://data.chubb.com/ontology/fnd/core/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

core:Agreement a owl:Class ;
    rdfs:label "Agreement"@en ;
    rdfs:subClassOf core:BusinessEntity .

core:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:subClassOf core:BusinessEntity .

core:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf core:LegalEntity ;
    owl:disjointWith core:Organization .

core:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:range xsd:string .

core: a owl:Ontology ;
    dct:description "Illustrative foundation module used by the ontology-governance demo."@en ;
    dct:issued "2026-08-20T08:22:43+00:00" ;
    dct:title "Chubb Enterprise Foundation Ontology - Demo"@en ;
    vann:preferredNamespacePrefix "core" ;
    vann:preferredNamespaceUri core: ;
    owl:versionIRI core:2.0.0 ;
    owl:versionInfo "2.0.0" .

core:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf core:LegalEntity .

core:LegalEntity a owl:Class ;
    rdfs:label "Legal Entity"@en ;
    rdfs:subClassOf core:BusinessEntity .

core:BusinessEntity a owl:Class ;
    rdfs:label "Business Entity"@en .

