@prefix claim: <https://data.chubb.com/ontology/ins/claim/> .
@prefix core: <https://data.chubb.com/ontology/fnd/core/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix policy: <https://data.chubb.com/ontology/ins/policy/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:againstPolicy a owl:ObjectProperty ;
    rdfs:label "against policy"@en ;
    rdfs:domain claim:Claim ;
    rdfs:range policy:Policy .

claim:claimNumber a owl:DatatypeProperty ;
    rdfs:label "claim number"@en ;
    rdfs:domain claim:Claim ;
    rdfs:range xsd:string .

claim:hasClaimStatus a owl:ObjectProperty ;
    rdfs:label "has claim status"@en ;
    rdfs:domain claim:Claim .

claim: a owl:Ontology ;
    dct:issued "2026-08-20T08:22:43+00:00" ;
    dct:title "Chubb Claim Ontology - Demo"@en ;
    vann:preferredNamespacePrefix "claim" ;
    vann:preferredNamespaceUri claim: ;
    owl:imports core:,
        policy: ;
    owl:versionIRI claim:2.0.0 ;
    owl:versionInfo "2.0.0" .

claim:Claim a owl:Class ;
    rdfs:label "Claim"@en ;
    rdfs:subClassOf core:Event .

